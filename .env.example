# ---- Gemini model backend: pick ONE ----
# (a) AI Studio key (simplest):
GOOGLE_API_KEY=your-ai-studio-key
# (b) Vertex AI (uncomment instead of GOOGLE_API_KEY):
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- BigQuery ----
# Project billed for running queries (needs the BigQuery API enabled).
# Falls back to GOOGLE_CLOUD_PROJECT if unset.
BQ_COMPUTE_PROJECT_ID=your-project
# Where the data lives. Defaults to a public dataset so no data loading is needed.
BQ_DATA_PROJECT_ID=bigquery-public-data
BQ_DATASET_ID=thelook_ecommerce
# Max rows fetched per query (rows shown in the UI are capped separately).
BQ_MAX_ROWS=1000

# ---- Agent / app ----
AGENT_MODEL=gemini-2.5-flash
AGUI_USER_ID=dashboard

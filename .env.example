# ---- Vertex AI (required; Gemini runs on Vertex, no AI Studio key) ----
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
# Service-account key path (absolute; ~ is NOT expanded). Used for both Gemini
# (via Vertex) and BigQuery. Locally, alternatively use
# `gcloud auth application-default login` instead of a SA key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# ---- BigQuery ----
# Project billed for running queries (needs the BigQuery API enabled).
# Falls back to GOOGLE_CLOUD_PROJECT if unset.
BQ_COMPUTE_PROJECT_ID=your-project
# Where the data lives. Defaults to a public dataset so no data loading is needed.
BQ_DATA_PROJECT_ID=bigquery-public-data
BQ_DATASET_ID=thelook_ecommerce
# Max rows fetched per query (rows shown in the UI are capped separately).
BQ_MAX_ROWS=1000

# ---- Agent / app ----
AGENT_MODEL=gemini-2.5-flash
# Optional: override the analytics sub-agent's model (defaults to AGENT_MODEL).
# ANALYTICS_AGENT_MODEL=gemini-2.5-flash
AGUI_USER_ID=dashboard

# Per-process throttle: minimum seconds between Gemini calls (root + sub-agent
# share one global). Defaults to 1.2 (~50 calls/min) which clears Vertex's
# typical 60-RPM per-project quota for gemini-2.5-flash. Bump higher (e.g. 2.0)
# if you still see 429 RESOURCE_EXHAUSTED.
# GEMINI_MIN_INTERVAL_S=1.2

# ---- Vertex Agent Engine + code-execution sandbox (analytics charts) ----
# Pin a pre-created Agent Engine + sandbox to skip lazy creation on cold start.
# Generate the resource names once with: python tools/probe_agent_engine.py
# (Leaving these unset is also fine — the executor will create them lazily
# on the first analytics call. Pinning is mainly to avoid orphan engines
# accumulating across sessions.)
AGENT_ENGINE_RESOURCE_NAME=
AGENT_ENGINE_SANDBOX_RESOURCE_NAME=
